# Copy this file to ".env" (same folder) and fill in your own key.
# .env is gitignored and is never read by anyone but your local backend process.

# Required for the "smart" pipeline (Gemini vision understanding + grounded story writing).
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional overrides
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45

# Wikipedia/Wikidata research step (no key needed). Set to false to disable.
NARRA_RESEARCH_ENABLED=true

# If GEMINI_API_KEY is not set, NARRA falls back to local open-source models
# (BLIP + FLAN-T5). Set to false to disable that fallback entirely.
NARRA_LOCAL_FALLBACK=true
NARRA_USE_CUDA=auto
